{
  "name": "verzel-store-qa",
  "version": "1.0.0",
  "description": "Teste técnico QA Júnior Verzel: validação de cupom de desconto e frete grátis da Verzel Store",
  "private": true,
  "license": "UNLICENSED",
  "author": "claudioc0",
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report playwright-report",
    "report:entrega": "playwright show-report evidencias/automacao/relatorio",
    "relatorio:entrega": "playwright test && node -e \"const fs=require('fs');fs.rmSync('evidencias/automacao/relatorio',{recursive:true,force:true});fs.cpSync('playwright-report','evidencias/automacao/relatorio',{recursive:true})\"",
    "evidencias:api": "node scripts/executar-api.mjs",
    "evidencias:ui": "node scripts/executar-ui.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
