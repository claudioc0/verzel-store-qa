{
  "name": "verzel-store-qa",
  "version": "1.0.0",
  "description": "Teste técnico QA Júnior Verzel: validação de cupom de desconto e frete grátis da Verzel Store",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report evidencias/automacao/relatorio",
    "evidencias:api": "node scripts/executar-api.mjs",
    "evidencias:ui": "node scripts/executar-ui.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "private": true
}
